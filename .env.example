# ---- Single account (simplest) ----
# provider: privateemail | zoho | zoho-pro | zoho-eu | zoho-in | gmail | outlook | yahoo | icloud
#           fastmail | titan | hostinger | godaddy | migadu | custom
EMAIL_PROVIDER=privateemail
EMAIL_ADDRESS=you@yourdomain.com
EMAIL_PASSWORD=your-password-or-app-password
# EMAIL_DISPLAY_NAME=Your Name
# EMAIL_USERNAME=login-if-different-from-address

# Only needed for provider=custom, or to override a preset:
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_SECURE=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true          # false for port 587 (STARTTLS)
# EMAIL_SAVE_TO_SENT=true   # append sent mail to the Sent folder

# ---- Multiple accounts ----
# EMAIL_ACCOUNTS_FILE=./accounts.json

# ---- Guardrails: what the AI is allowed to do ----------------------
# true = allowed, false = blocked. Disabled tools are hidden from the AI
# entirely, and every action is re-checked on the server before it runs.
# Blank = the default shown in brackets.

# Master switch: true turns OFF everything below (read/search only). [false]
EMAIL_READ_ONLY=false

# Send new emails and replies. [true]
EMAIL_ALLOW_SEND=true
# Forward existing emails, including their attachments. Needs SEND. [true]
EMAIL_ALLOW_FORWARD=true
# Save drafts (including draft replies). [true]
EMAIL_ALLOW_DRAFTS=true
# Mark read/unread and flag/unflag. [true]
EMAIL_ALLOW_MARK=true
# Move emails between folders (except into Trash, which counts as delete). [true]
EMAIL_ALLOW_MOVE=true
# Delete = move to Trash. [true]
EMAIL_ALLOW_DELETE=true
# Erase permanently (skip Trash, or delete from Trash). Needs DELETE. [false]
EMAIL_ALLOW_PERMANENT_DELETE=false

# Who the AI may send/reply/forward to. Comma-separated domains or addresses,
# e.g. navo.health,partner@example.com  (blank = anyone) []
EMAIL_ALLOWED_RECIPIENTS=
# Max recipients (to + cc + bcc) in one email. [20]
EMAIL_MAX_RECIPIENTS=20

# ---- HTTP mode (ChatGPT, claude.ai web) ----
# MCP_AUTH_TOKEN=generate-with: openssl rand -hex 32
# PORT=3000
# HOST=127.0.0.1            # use 0.0.0.0 when deploying to a server/container
